data/*
!data/.htaccess

# 隨附的可攜式 PHP（約 90 MB，可由 windows.php.net 下載；cacert.pem 是從本機匯出的憑證）
php/

# 暫存
*.tmp
.claude/

# 隨附的可攜式 Python 與 OCR 模型（約 400 MB；重建方式見 ocr/README.txt）
ocr/python/
ocr/server.log
ocr/get-pip.py

ocr/__pycache__/

ocr/php-server.log

# 評測用的標準答案、AI 回應快取與報告（機構編目資料，不要上傳）
eval/gold/
eval/cache/
eval/out/

